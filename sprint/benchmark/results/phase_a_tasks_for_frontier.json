  {
    "name": "unfold_n",
    "theorem_name": "unfoldN",
    "description": "Generate list by repeated function application",
    "goal_state": "n : Nat\nf : Int → Int\nseed : Int\n⊢ List Int",
    "test_cases": [
      {
        "input": "4",
        "input2": "(fun x : Int => x + 1)",
        "input3": "0",
        "expected": "[0, 1, 2, 3]"
      },
      {
        "input": "0",
        "input2": "(fun x : Int => x + 1)",
        "input3": "5",
        "expected": "[]"
      },
      {
        "input": "3",
        "input2": "(fun x : Int => x * 2)",
        "input3": "1",
        "expected": "[1, 2, 4]"
      }
    ]
  },
